# Resend — domain in EMAIL_FROM must be verified in Resend
RESEND_API_KEY=re_xxx
EMAIL_TO=hi@manishtamang.com
EMAIL_FROM=GitHub <github@manishtamang.com>

# GitHub
GITHUB_USERNAME=Manish-Tamang
# Fine-grained PAT with Account permission "Gists: Read and write"
GITHUB_TOKEN=github_pat_xxx
# Same secret you enter in the GitHub App / repo webhook settings
GITHUB_WEBHOOK_SECRET=change-me
# Secret gist holding the follower snapshot (file: followers.json, initial content: {})
GIST_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared with the GitHub Action (repo secret CRON_SECRET)
CRON_SECRET=change-me
